# Copie este archivo como .env y cambie las claves. El archivo .env nunca se sube a Git.

# --- Base de datos
POSTGRES_DB=inventario
POSTGRES_USER=inventario
POSTGRES_PASSWORD=cambie-esta-clave
# Puerto local para conectarse a PostgreSQL desde este equipo (desarrollo y respaldos)
PUERTO_DB=5433

# --- Aplicación
ENTORNO=produccion
# true cuando el sistema se sirva por HTTPS (obligatorio para usar la cámara en celulares)
COOKIE_SEGURA=false
SESION_DURACION_HORAS=12
LOG_NIVEL=INFO

# --- Datos iniciales (python -m app.cli inicializar)
EMPRESA_NOMBRE=Mi Distribuidora
DUENO_CORREO=dueno@empresa.bo
DUENO_PASSWORD=cambie-esta-clave-larga
DUENO_NOMBRE=Nombre
DUENO_APELLIDO=Apellido

# --- Servidor web
PUERTO_WEB=8080
PUERTO_WEB_HTTPS=8443
# ":80" = HTTP en la red local. Con un dominio propio, ponga el dominio para tener HTTPS.
SITIO_DIRECCION=:80

# Archivos subidos (OC y constancias). En Docker van al volumen "archivos".
# ARCHIVO_MAX_MB=15
