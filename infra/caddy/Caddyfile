{
	servers {
		# Confía en X-Forwarded-For de proxies de la red privada (Docker, Tailscale) para que
		# la auditoría registre la IP real del cliente.
		trusted_proxies static private_ranges
	}
}

# SITIO_DIRECCION: ":80" sirve HTTP en la red local. Con un dominio (p. ej. inventario.midominio.bo)
# Caddy obtiene certificados HTTPS automáticamente. Ver docs/adr/0002-despliegue-en-oficina.md.
{$SITIO_DIRECCION::80} {
	encode zstd gzip

	request_body {
		max_size 25MB
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv

		@sin_cache path / /index.html /sw.js /manifest.webmanifest /registerSW.js
		header @sin_cache Cache-Control "no-cache"

		@recursos path /assets/*
		header @recursos Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
